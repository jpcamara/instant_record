<% content_for(:title, "#{@draft.title} — InstantRecord") %>

<div class="page" data-controller="draft" data-instant-refresh
     data-draft-url-value="<%= draft_path(@draft) %>"
     data-action="instant-record:records-changed@window->draft#pull">
  <header class="page-header">
    <h1><%= @draft.title %></h1>
    <p class="meta">
      Each save sends the title's and the text's whole Yjs documents. The
      server merges them with the ones it holds, so offline edits to either
      field all survive. What it shows everyone is read from the merged
      documents.
    </p>
  </header>

  <div class="card">
    <input class="draft-title" type="text" aria-label="Draft title" value="<%= @draft.title %>"
           data-draft-target="field" data-column="title" data-action="input->draft#input">
    <textarea class="draft-editor" rows="10" aria-label="Draft text"
              data-draft-target="field" data-column="body" data-action="input->draft#input"><%= @draft.body %></textarea>
  </div>
  <%= render "state" %>

  <p class="meta">This page was rendered by Rails <%= InstantRecord.browser? ? "inside your browser" : "on the server" %>: <b><%= InstantRecord.browser? ? "Spinel + SQLite" : "CRuby + Postgres" %></b>.</p>
</div>
